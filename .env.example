# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed variables.

# Base URL for the Synnex CRM API (Express + MySQL). No trailing slash.
# The backend listens on PORT from its own .env, 3000 by default.
VITE_API_BASE_URL=http://localhost:3000/api

# Per-feature API source: "http" (the real backend) or "mock".
#
# Each feature has its own flag so a module can be developed against mock data
# while the rest talks to the server. Both implementations expose the same
# function signatures and return shapes, so nothing above api/ changes when a
# flag flips.
#
# Running against "http" needs the backend up and seeded:
#   cd ../software-crm-backend && npm run dev && npm run seed
# Seeded logins, all password123:
#   admin@synnexit.com    Admin      full access
#   support@synnexit.com  Support    no product catalogue writes
#   dev@synnexit.com      Developer  read-only outside issue status
VITE_AUTH_API=http
VITE_CUSTOMERS_API=http
VITE_ISSUES_API=http
VITE_QUOTATIONS_API=http
VITE_DASHBOARD_API=http
VITE_PRODUCTS_API=http
