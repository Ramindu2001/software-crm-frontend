# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed variables.

# Base URL for the Laravel API. No trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api

# Per-feature API source: "mock" (default) or "http".
#
# Each feature has its own flag so the backend can be adopted one module at a
# time — point issues at the real API while auth stays mocked, or vice versa.
VITE_AUTH_API=mock
VITE_ISSUES_API=mock
